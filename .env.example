NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — NEVER prefixed with NEXT_PUBLIC_, never sent to the
# browser. Read by scripts/rips-import/*.mjs (official RIPS catalogs, see
# docs/rips-catalogs.md) and by src/lib/supabase/admin.ts, the one
# server-only app runtime helper allowed to use it (currently just the
# Marketplace SSO exchange endpoint).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret authenticating Marketplace's server-to-server calls to
# POST /api/sso/exchange (Authorization: Bearer <value>). Dedicated to
# this one integration — never the service role key, SESSION_SECRET, or
# any other existing credential. Placeholder only; never commit a real
# value here.
MARKETPLACE_SSO_SHARED_SECRET=changeme-placeholder-never-a-real-secret

# Marketplace's own canonical base URL — server-only, read by
# GET /marketplace/entrar (src/app/marketplace/entrar/route.ts) to build
# the ONLY redirect target it will ever send the browser to
# (<MARKETPLACE_URL>/auth/sso/callback). Never used to validate anything
# from the browser directly. Placeholder only; never commit a real value
# here.
MARKETPLACE_URL=https://marketplace.example.invalid
