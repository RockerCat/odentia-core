NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — NEVER prefixed with NEXT_PUBLIC_, never used by app
# code, never sent to the browser. Only scripts/rips-import/*.mjs reads
# this, to write official RIPS catalogs (see docs/rips-catalogs.md).
SUPABASE_SERVICE_ROLE_KEY=
